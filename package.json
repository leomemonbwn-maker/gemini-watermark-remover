{
  "name": "gemclean-ai",
  "version": "1.0.0",
  "description": "GemClean AI – Free, private, in-browser tool to remove visible AI sparkle watermarks from Gemini images and Veo videos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i ./src/style.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/style.css -o ./public/css/output.css --watch",
    "build": "npm run build:css && vite build",
    "build:ext": "npm run build:css && vite build && node scripts/build-ext.js",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/gemclean-ai.git"
  },
  "keywords": [
    "gemclean",
    "gemini",
    "watermark",
    "remover",
    "ai",
    "vue",
    "vite",
    "tailwind"
  ],
  "author": "GemClean AI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-username/gemclean-ai/issues"
  },
  "homepage": "https://gemini-watermark-remover-taupe.vercel.app",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "mediabunny": "^1.49.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.7"
  }
}
